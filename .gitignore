# Public repository: source code, tests and curated reproducibility releases.
# Dataset distribution authorised by the corresponding author on 2026-10-13.
# datasets/ and reproducibility/ contain the reviewed public snapshot.
# Internal working data, manuscript drafts and credentials remain excluded.

# ---------------------------------------------------------------------------
# 1. Dados e resultados de trabalho
# ---------------------------------------------------------------------------
# The reviewed public snapshot is under datasets/; this directory is working data.
/data/

# Figuras do manuscrito e manifestos de execução.
/artifacts/

# ---------------------------------------------------------------------------
# 2. Documentos internos — não públicos
# ---------------------------------------------------------------------------
# Documento de trabalho do grupo.
/briefing.md
# Plano analítico da reanálise; cita os comentários dos revisores (confidenciais).
/ESPECIFICACAO_REANALISE.md
# Histórico de desenvolvimento com os resultados científicos em detalhe.
/CHANGELOG.md
# Especificações, planos e protocolo interno.
/docs/

# ---------------------------------------------------------------------------
# 3. Artefatos de execução — pesados e regeneráveis
# ---------------------------------------------------------------------------
/.venv/
# 3,4 GB de checkpoints de modelo
/saved_models/
# ~1.800 diretórios de treino DL
/lightning_logs/
/catboost_info/
/.pt_tmp/
# scripts de investigação ad-hoc
/scratchpad/
*.log

# ---------------------------------------------------------------------------
# 4. Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# 5. Ambiente local e SO
# ---------------------------------------------------------------------------
# config de venv local (in-project), não é do projeto
poetry.toml
.env
.envrc
.DS_Store
Thumbs.db
*.swp

# Árvore montada do depósito (resultado + material restrito); é gerada por
# `tb-outcomes build-deposit` e vai ao Zenodo, não ao repositório de código.
/deposit/

# Manuscrito: texto, template e PDFs. É conteúdo de publicação, não código.
/manuscrito/

/publicacao/
/outputs/
